class Solution {
    public int sortableIntegers(int[] nums) {
        int n = nums.length;

        int[] prefMax = new int[n + 1];
        int[] suffMin = new int[n + 1];
        int[] drops = new int[n];

        for (int i = 0; i < n; i++) {
            prefMax[i + 1] = Math.max(prefMax[i], nums[i]);
        }

        suffMin[n] = Integer.MAX_VALUE;
        for (int i = n - 1; i >= 0; i--) {
            suffMin[i] = Math.min(nums[i], suffMin[i + 1]);
        }

        for (int i = 1; i < n; i++) {
            drops[i] = drops[i - 1] + (nums[i - 1] > nums[i] ? 1 : 0);
        }

        int ans = 0;

        for (int k = 1; k <= n; k++) {
            if (n % k != 0) continue;

            boolean valid = true;
            int prevMax = 0;

            for (int start = 0; start < n; start += k) {
                int end = start + k - 1;

                int count = drops[end] - drops[start];
                if (nums[end] > nums[start]) count++;

                if (count > 1 || prevMax > suffMin[start]) {
                    valid = false;
                    break;
                }

                prevMax = prefMax[end + 1];
            }

            if (valid) ans += k;
        }

        return ans;
    }
}
