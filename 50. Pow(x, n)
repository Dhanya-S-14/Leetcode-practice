class Solution {
    public double myPow(double x, int n) {
        long N = n;
        
        // Take the absolute value of the exponent to avoid early division precision loss
        if (N < 0) {
            N = -N;
        }
        
        double result = 1.0;
        double currentProduct = x;
        
        // Standard Binary Exponentiation
        while (N > 0) {
            if (N % 2 == 1) {
                result *= currentProduct;
            }
            currentProduct *= currentProduct;
            N /= 2;
        }
        
        // Apply the negative exponent inversion only once at the end
        return n < 0 ? 1.0 / result : result;
    }
}
